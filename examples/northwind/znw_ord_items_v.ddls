@EndUserText.label : 'Northwind Order Items (orders+details+customers+products)'
@AccessControl.authorizationCheck : #NOT_REQUIRED
define view ZNW_ORD_ITEMS_V
  as select from znw_ord_details as d
    inner join znw_orders    as o on  o.client     = d.client
                                  and o.order_id   = d.order_id
    inner join znw_customers as c on  c.client     = o.client
                                  and c.cust_id    = o.cust_id
    inner join znw_products  as p on  p.client     = d.client
                                  and p.product_id = d.product_id
{
  d.order_id,
  d.product_id,

  o.cust_id,
  o.order_date,
  o.required_date,
  o.shipped_date,
  o.freight,
  o.ship_country,

  c.comp_name      as customer_name,
  c.city           as customer_city,
  c.country        as customer_country,

  p.product_name,
  p.category_id,

  d.unit_price,
  d.quantity,
  d.discount,

  cast( d.unit_price * cast( d.quantity as abap.dec(13,4) )
        as abap.dec(13,4) ) as gross_amount
}
