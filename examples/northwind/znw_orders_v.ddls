@EndUserText.label : 'Northwind Orders'
@AccessControl.authorizationCheck : #NOT_REQUIRED
define view entity ZNW_ORDERS_V
  as select from znw_orders
{
  key order_id,
      cust_id,
      employee_id,
      order_date,
      required_date,
      shipped_date,
      ship_via,
      freight,
      ship_name,
      ship_address,
      ship_city,
      ship_region,
      ship_postal_code,
      ship_country
}
