@EndUserText.label : 'Northwind Customers'
@AccessControl.authorizationCheck : #NOT_REQUIRED
define view entity ZNW_CUSTOMERS_V
  as select from znw_customers
{
  key cust_id,
      comp_name,
      contact_name,
      contact_title,
      address,
      city,
      region,
      postal_code,
      country,
      phone,
      fax
}
